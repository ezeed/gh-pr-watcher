#!/usr/bin/env bash
# gh-pr-watcher: keeps your open PRs up to date (same as the "Update branch" button)
# and sends a notification when a conflict needs to be resolved by hand.
set -uo pipefail

VERSION="0.2.0"
NAME="gh-pr-watcher"
LABEL="local.gh-pr-watcher"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/$NAME"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/$NAME"
CONFIG="$CONFIG_DIR/config"
STATE="$STATE_DIR/state.json"
CONFLICTS="$STATE_DIR/conflicts.json"
CONFLICTS_PAGE="$STATE_DIR/conflicts.html"
REMINDED="$STATE_DIR/conflicts_reminded.json"
LOG="$STATE_DIR/watcher.log"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LAST_ERROR="$STATE_DIR/last_error"
LAST_RUN="$STATE_DIR/last_run"
LOCK_DIR="$STATE_DIR/run.lock"
LOG_MAX_LINES=2000
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
DEFAULT_IMAGE="$SELF_DIR/assets/icon.png"

CONFIG_KEYS="GH_USER OWNERS REPOS EVERY_MINUTES INCLUDE_DRAFTS SKIP_LABEL NOTIFY_IMAGE"
# Read from older configs and converted to EVERY_MINUTES; never written.
LEGACY_KEYS="EVERY_HOURS"
EVERY_OPTIONS="15 30 60 120 180"
# Conflicts already notified are reminded at most this often, whatever the frequency.
REMIND_EVERY_SEC=3300

# Defaults; the config file overrides them.
GH_USER=""
OWNERS=""
REPOS=""
EVERY_MINUTES="60"
EVERY_HOURS=""
LEGACY_EVERY=0
INCLUDE_DRAFTS="false"
SKIP_LABEL=""
NOTIFY_IMAGE=""

# IN_RUN=1 inside a real run: fatal errors go to the log and get notified,
# because under launchd nobody reads stderr.
IN_RUN=0
HAVE_LOCK=0
GH_ERR_FILE=""

usage() {
  cat <<EOF
$NAME $VERSION — keeps your open PRs up to date and flags conflicts.

Usage: gh pr-watcher <command> [options]

Commands:
  install [options]       Saves the config and schedules the run (launchd on macOS;
                          on Linux it prints the crontab line). With a terminal and no flags,
                          it asks; with flags, --yes or no terminal, it asks nothing.
    --user LOGIN            gh account to use.
    --owners "A B"          Orgs or users to watch ("" = all your PRs).
    --repos "o/r o/r"       Only these repos (replaces --owners).
    --every 15m|30m|1h|2h|3h
                            How often it runs, starting at 0:00.
    --drafts | --no-drafts  Update drafts or not.
    --skip-label L | --no-skip-label
                            Exclude PRs with label L.
    --notify-image PATH     Image attached to notifications ("" = the bundled one).
    --yes                   Don't ask: existing config + flags + defaults.
    --dry-run               Show what it would write, without touching anything.
  detect [--user LOGIN]   JSON with what's needed to decide the install: accounts,
                          orgs, repos with your PRs, dependencies, current config and install.
  run [--dry-run]         One run now. --dry-run reports without updating branches,
                          notifying or saving state.
  test-notify             Sends a test notification.
  doctor [--json]         Checks dependencies, session, config, schedule and the last
                          run, with the fix for each problem. Changes nothing.
  status [--json]         Config, agent state and the last log lines.
  config                  Shows the config file path and contents.
  log [N]                 Last N log lines (default 30).
  uninstall               Removes the schedule. Config and log stay.
  version                 Version.

Errors: message on stderr prefixed with "error:" and a non-zero exit code.

Files:
  config  $CONFIG
  state   $STATE_DIR/
EOF
}

die() {
  [ "$IN_RUN" = "1" ] && fatal "$*"
  echo "error: $*" >&2
  exit 1
}

# Error that stops a real run: logged, and notified once per distinct message.
fatal() {
  log "ERROR: $* (diagnose: gh pr-watcher doctor)"
  if [ "$(cat "$LAST_ERROR" 2>/dev/null)" != "$*" ]; then
    printf '%s\n' "$*" >"$LAST_ERROR"
    notify "stopped working · gh pr-watcher doctor" "$*" "file://$LOG" "error"
  fi
  exit 1
}

warn() {
  if [ "$IN_RUN" = "1" ]; then log "warning: $*"; else echo "warning: $*" >&2; fi
}

# No network is not a watcher failure: during a run it waits for the next one, silently.
offline() {
  if [ "$IN_RUN" = "1" ]; then
    log "no connection to GitHub, will retry next run ($*)"
    exit 0
  fi
  die "could not connect to GitHub: $*"
}

is_network_error() {
  grep -qiE 'dial tcp|no such host|connection refused|i/o timeout|tls handshake|network is unreachable|context deadline|connection reset' <<<"$1"
}

# gh with stderr captured; gh_err returns the reason for the last failure on one line.
ghq() { gh "$@" 2>"$GH_ERR_FILE"; }
gh_err() { grep -v '^{' "$GH_ERR_FILE" 2>/dev/null | head -3 | tr '\n' ' ' | sed 's/ *$//'; }

# Stops with gh's reason, telling a missing network apart from a real error.
gh_fail() {
  local what="$1" err
  err=$(gh_err)
  is_network_error "$err" && offline "$err"
  die "$what: ${err:-no details from gh}"
}

# An older config keeps its EVERY_HOURS schedule until the next install.
valid_config_every() {
  offered_every "$EVERY_MINUTES" && return 0
  [ "$LEGACY_EVERY" = "1" ] && [ "$EVERY_MINUTES" -ge 60 ] && [ "$EVERY_MINUTES" -le 1440 ]
}

offered_every() { case " $EVERY_OPTIONS " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# Minutes out of --every: "15m", "2h" or a bare number of minutes; empty if it isn't one.
parse_every() {
  case "$1" in
    *[!0-9mh]*|"") ;;
    *m) [[ "${1%m}" =~ ^[0-9]+$ ]] && echo $((10#${1%m})) ;;
    *h) [[ "${1%h}" =~ ^[0-9]+$ ]] && echo $((10#${1%h} * 60)) ;;
    *) [[ "$1" =~ ^[0-9]+$ ]] && echo $((10#$1)) ;;
  esac
}

# No pipe to grep -q: it stops reading, gh gets SIGPIPE and pipefail counts it as failed.
gh_supports_json() {
  local help
  help=$(gh auth status --help 2>/dev/null)
  [[ "$help" == *"--json"* ]]
}

require_jq() { command -v jq >/dev/null || die "jq is missing (brew install jq)"; }

require_gh() {
  command -v gh >/dev/null || die "gh, the GitHub CLI, is missing (brew install gh)"
  gh_supports_json || die "your gh is too old ($(gh --version 2>/dev/null | head -1)); upgrade it (brew upgrade gh)"
}

# Valid session for GH_USER (or the active one) with the repo scope, which update-branch needs.
require_session() {
  local hosts login entry state err scopes
  hosts=$(gh auth status --hostname github.com --json hosts 2>/dev/null) \
    || die "could not read the gh session (gh auth status)"
  login="$GH_USER"
  [ -n "$login" ] || login=$(jq -r '.hosts["github.com"][]? | select(.active) | .login' <<<"$hosts")
  [ -n "$login" ] || die "gh has no session on github.com; run gh auth login"
  entry=$(jq -c --arg l "$login" '.hosts["github.com"][]? | select(.login == $l)' <<<"$hosts")
  [ -n "$entry" ] || die "gh has no session as '$login'; run gh auth login"
  state=$(jq -r '.state // ""' <<<"$entry")
  if [ "$state" != "success" ]; then
    err=$(jq -r '.error // ""' <<<"$entry")
    is_network_error "$err" && offline "$err"
    die "the gh session for '$login' is not valid (${err:-$state}); run gh auth refresh -h github.com"
  fi
  scopes=$(jq -r '.scopes // ""' <<<"$entry")
  if [ -n "$scopes" ] && ! [[ ", $scopes," =~ ,\ repo, ]]; then
    die "the token for '$login' is missing the repo scope; run gh auth refresh -h github.com -s repo"
  fi
}

# Echoes only to a terminal or a pipe: under launchd stdout is launchd.out.log and would duplicate the log.
log() {
  mkdir -p "$STATE_DIR"
  if [ -t 1 ] || [ -p /dev/stdout ]; then
    printf '%s %s\n' "$(date '+%F %T')" "$*" | tee -a "$LOG"
  else
    printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"
  fi
}

# Keeps each log at its last LOG_MAX_LINES lines, rewritten in place: launchd holds the files open.
trim_logs() {
  local f
  for f in "$LOG" "$STATE_DIR/launchd.out.log" "$STATE_DIR/launchd.err.log"; do
    [ -f "$f" ] || continue
    [ "$(wc -l <"$f")" -gt "$LOG_MAX_LINES" ] || continue
    tail -n "$LOG_MAX_LINES" "$f" >"$f.tmp.$$" && cat "$f.tmp.$$" >"$f"
    rm -f "$f.tmp.$$"
  done
}

# Reads KEY=VALUE without executing the file; ignores comments and unknown keys.
load_config() {
  [ -f "$CONFIG" ] || return 0
  local line key value
  while IFS= read -r line || [ -n "$line" ]; do
    [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
    if ! [[ "$line" =~ ^[[:space:]]*([A-Za-z_]+)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
      warn "ignored line in $CONFIG (expected KEY=VALUE): $line"
      continue
    fi
    key="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"
    value="${value%"${value##*[![:space:]]}"}"
    value="${value#\"}"; value="${value%\"}"
    case " $CONFIG_KEYS " in
      *" $key "*) printf -v "$key" '%s' "$value" ;;
      *) case " $LEGACY_KEYS " in *" $key "*) printf -v "$key" '%s' "$value"; continue ;; esac
         warn "unknown key in $CONFIG: $key$(suggest_key "$key")" ;;
    esac
  done <"$CONFIG"
  if [ -n "$EVERY_HOURS" ] && ! grep -qE '^[[:space:]]*EVERY_MINUTES[[:space:]]*=' "$CONFIG"; then
    if [[ "$EVERY_HOURS" =~ ^[0-9]+$ ]] && [ "$EVERY_HOURS" -ge 1 ] && [ "$EVERY_HOURS" -le 24 ]; then
      EVERY_MINUTES=$((10#$EVERY_HOURS * 60))
      LEGACY_EVERY=1
    else
      EVERY_MINUTES="$EVERY_HOURS"
    fi
  fi
}

suggest_key() {
  local k upper
  upper=$(tr '[:lower:]' '[:upper:]' <<<"$1")
  for k in $CONFIG_KEYS; do
    if [ "$k" = "$upper" ] || [[ "$k" == "$upper"* ]] || [[ "$upper" == "$k"* ]]; then
      printf ' (did you mean %s?)' "$k"
      return 0
    fi
  done
}

write_config() {
  mkdir -p "$CONFIG_DIR"
  cat >"$CONFIG" <<EOF
# $NAME — read as KEY=VALUE, never executed. Edit it and you're done: the next run picks it up.
# If you change EVERY_MINUTES, run \`gh pr-watcher install --yes\` to reschedule.

# gh account to use (\`gh auth status\` lists them). Empty = the active account.
GH_USER=$GH_USER

# Owners (orgs or users) separated by spaces. Empty = all your open PRs on GitHub.
OWNERS=$OWNERS

# Specific owner/repo repos separated by spaces. If any is set, only those are watched and OWNERS is ignored.
REPOS=$REPOS

# How often it runs, in minutes, counting from 0:00: 15, 30, 60, 120 or 180.
EVERY_MINUTES=$EVERY_MINUTES

# true = also update drafts.
INCLUDE_DRAFTS=$INCLUDE_DRAFTS

# PRs with this label are left alone (e.g. no-autoupdate). Empty = none are excluded.
SKIP_LABEL=$SKIP_LABEL

# Local PNG/JPG image attached to notifications (terminal-notifier only). Empty = the bundled one.
NOTIFY_IMAGE=$NOTIFY_IMAGE
EOF
}

validate_config() {
  valid_config_every || die "EVERY_MINUTES must be one of $EVERY_OPTIONS (got '$EVERY_MINUTES')"
  case "$OWNERS" in *,*) die "OWNERS must be separated by spaces, not commas (got '$OWNERS')" ;; esac
  case "$REPOS" in *,*) die "REPOS must be separated by spaces, not commas (got '$REPOS')" ;; esac
  local ow
  for ow in $GH_USER $OWNERS; do
    [[ "$ow" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,38})$ ]] || die "'$ow' is not a valid GitHub user or org"
  done
  [ -z "$GH_USER" ] || [ "$(wc -w <<<"$GH_USER" | tr -d ' ')" = "1" ] || die "GH_USER is a single account (got '$GH_USER')"
  if [ -n "$NOTIFY_IMAGE" ] && [ ! -r "$NOTIFY_IMAGE" ]; then
    die "NOTIFY_IMAGE is not a readable file: '$NOTIFY_IMAGE'"
  fi
  local rp
  for rp in $REPOS; do
    [[ "$rp" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "REPOS has an invalid repo: '$rp' (expected owner/repo)"
  done
  case "$INCLUDE_DRAFTS" in true|false) ;; *) die "INCLUDE_DRAFTS must be true or false (got '$INCLUDE_DRAFTS')" ;; esac
}

# With GH_USER, the whole run uses that account's token even if another one is active.
use_account() {
  [ -n "$GH_USER" ] || return 0
  local token
  token=$(gh auth token --user "$GH_USER" 2>/dev/null) || die "gh has no session as '$GH_USER'; run gh auth login"
  export GH_TOKEN="$token"
}

# System notification; on macOS clicking it opens the PR. With no notifier available, only the log remains.
notify() { # subtitle message url group
  if command -v terminal-notifier >/dev/null; then
    local img="${NOTIFY_IMAGE:-$DEFAULT_IMAGE}" extra=()
    [ -r "$img" ] && extra=(-contentImage "$img")
    terminal-notifier -title "PR watcher" -subtitle "$1" -message "$2" -open "$3" \
      -sound Ping -group "$NAME-$4" ${extra[@]+"${extra[@]}"} >/dev/null 2>&1 && return 0
  fi
  if command -v osascript >/dev/null; then
    osascript - "$2" "$1" >/dev/null 2>&1 <<'APPLESCRIPT' && return 0
on run argv
  display notification (item 1 of argv) with title "PR watcher" subtitle (item 2 of argv)
end run
APPLESCRIPT
  fi
  if command -v notify-send >/dev/null; then
    notify-send "PR watcher · $1" "$2 $3" >/dev/null 2>&1 && return 0
  fi
  return 0
}

# Keeps the PR's previous state when a run gets no new answer, so a known conflict stays in
# the reminder instead of dropping out of it. Uses cmd_run's variables.
keep_prev() {
  [ -n "$prev" ] || return 0
  new_state=$(jq --arg k "$key" --arg v "$prev" '.[$k]=$v' <<<"$new_state")
  [ "$prev" = "CONFLICTING" ] || return 0
  conflicts=$(jq --arg k "$key" --arg u "https://github.com/$repo/pull/$num" --argjson now "$now" \
    --argjson old "$old_conflicts" \
    '. + [$old[$k] // {title: "", url: $u, behind: "?", base: "", since: $now} | .key = $k]' <<<"$conflicts")
}

# "core#926" out of "N5Now/core#926": the owner is noise in a notification.
short_key() { printf '%s' "${1#*/}"; }

# Local page listing the open conflicts, for the notification that groups several.
write_conflicts_page() { # conflicts_json
  jq -r --arg now "$(date '+%F %H:%M')" '
    def row: "<li><a href=\"\(.url | @html)\">\(.key | @html)</a>"
      + (if .title != "" then " · \(.title | @html)" else "" end)
      + "<small>\(.behind | tostring | @html) commits behind \(.base | @html)"
      + " · conflicting since \(.since | strflocaltime("%F %H:%M"))</small></li>";
    "<!doctype html><html><head><meta charset=\"utf-8\"><title>PR watcher · conflicts</title>",
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><style>",
    ":root{color-scheme:light dark;--fg:#1f2328;--muted:#59636e;--bg:#fff;--link:#0969da;--line:#d1d9e0}",
    "@media (prefers-color-scheme:dark){:root{--fg:#f0f6fc;--muted:#9198a1;--bg:#0d1117;--link:#4493f8;--line:#3d444d}}",
    "body{font:15px/1.5 -apple-system,system-ui,sans-serif;color:var(--fg);background:var(--bg);max-width:720px;margin:40px auto;padding:0 16px}",
    "h1{font-size:20px}ul{list-style:none;padding:0}li{padding:12px 0;border-bottom:1px solid var(--line)}",
    "a{color:var(--link);font-weight:600}small{display:block;color:var(--muted)}p{color:var(--muted)}",
    "</style></head><body>",
    (if length == 0 then "<h1>No PRs with conflicts</h1>"
     else "<h1>\(length) PRs with conflicts</h1><ul>" + (map(row) | join("")) + "</ul>" end),
    "<p>Updated \($now) by gh pr-watcher.</p></body></html>"' <<<"$1"
}

# One notification for every open conflict, repeated while they last but at most every
# REMIND_EVERY_SEC unless one is new or the list changed; the shared group replaces the banner.
notify_conflicts() { # conflicts_json dry_run
  local n new first subtitle message url keys last_at=0 last_keys=""
  n=$(jq length <<<"$1")
  if [ "$n" = "0" ]; then
    [ "$2" = "0" ] && rm -f "$REMINDED"
    [ "$2" = "0" ] && command -v terminal-notifier >/dev/null \
      && terminal-notifier -remove "$NAME-conflicts" >/dev/null 2>&1
    return 0
  fi
  new=$(jq --argjson now "$now" '[.[] | select(.since == $now)] | length' <<<"$1")
  keys=$(jq -r '[.[].key] | sort | join(" ")' <<<"$1")
  if [ -s "$REMINDED" ]; then
    last_at=$(jq -r '.at // 0' "$REMINDED" 2>/dev/null) || last_at=0
    last_keys=$(jq -r '.keys // ""' "$REMINDED" 2>/dev/null) || last_keys=""
  fi
  if [ "$new" = "0" ] && [ "$keys" = "$last_keys" ] && [ $((now - last_at)) -lt "$REMIND_EVERY_SEC" ]; then
    log "$n PR(s) still conflicting, already reminded at $(fmt_epoch "$last_at")"
    return 0
  fi
  if [ "$n" = "1" ]; then
    first=$(jq -c '.[0]' <<<"$1")
    url=$(jq -r .url <<<"$first")
    if [ "$new" = "1" ]; then
      subtitle="$(short_key "$(jq -r .key <<<"$first")") · conflict needs attention"
    else
      subtitle="$(short_key "$(jq -r .key <<<"$first")") · still conflicting since $(jq -r '.since | strflocaltime("%H:%M")' <<<"$first")"
    fi
    message=$(jq -r '(if .title != "" then "\(.title) " else "" end) + "(\(.behind) commits behind \(.base))."' <<<"$first")
  else
    url="file://$CONFLICTS_PAGE"
    subtitle="$n PRs with conflicts"
    [ "$new" != "0" ] && subtitle="$subtitle ($new new)"
    message=$(jq -r '[.[].key | sub("^[^/]*/"; "")] | join(", ")' <<<"$1")
  fi
  if [ "$2" = "1" ]; then
    log "(dry-run) would notify: $subtitle — $message"
    return 0
  fi
  [ "$n" = "1" ] || write_conflicts_page "$1" >"$CONFLICTS_PAGE"
  log "notifying: $subtitle — $message"
  notify "$subtitle" "$message" "$url" "conflicts"
  jq -n --argjson at "$now" --arg keys "$keys" '{at: $at, keys: $keys}' >"$REMINDED"
}

cmd_run() {
  local dry_run=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry_run=1 ;;
      *) die "unknown option for run: $1" ;;
    esac
    shift
  done

  [ "$dry_run" = "1" ] || IN_RUN=1
  mkdir -p "$STATE_DIR"
  # Records every real run, even if it later fails or has no network: doctor uses it to tell whether launchd fires.
  [ "$IN_RUN" = "1" ] && date +%s >"$LAST_RUN"
  load_config
  validate_config
  require_jq
  require_gh
  require_session
  use_account
  if ! acquire_lock; then
    log "a run is already in progress (pid $(cat "$LOCK_DIR/pid" 2>/dev/null)), skipping this one"
    return 0
  fi
  [ "$IN_RUN" = "1" ] && trim_logs

  local old_state='{}' old_conflicts='{}' now
  now=$(date +%s)
  if [ -s "$STATE" ]; then
    if jq -e 'type == "object"' "$STATE" >/dev/null 2>&1; then
      old_state=$(cat "$STATE")
    else
      warn "the state ($STATE) was corrupted and is discarded"
    fi
  fi
  if [ -s "$CONFLICTS" ]; then
    old_conflicts=$(jq -c 'if type == "array" then map({(.key): .}) | add // {} else {} end' "$CONFLICTS" 2>/dev/null) \
      || old_conflicts='{}'
  fi

  local args=(search prs --author @me --state open --limit 100
    --json "repository,number,isDraft,labels,title,url")
  local o r
  # gh search ANDs --owner and --repo: when repos are chosen, orgs are not passed.
  if [ -n "$REPOS" ]; then
    for r in $REPOS; do args+=(--repo "$r"); done
  else
    for o in $OWNERS; do args+=(--owner "$o"); done
  fi

  local found
  found=$(ghq "${args[@]}") || gh_fail "the PR search on GitHub failed"

  local prs
  prs=$(jq -r --arg skip "$SKIP_LABEL" --argjson drafts "$INCLUDE_DRAFTS" '
    .[] | select($drafts or (.isDraft | not))
        | select($skip == "" or ([.labels[].name] | index($skip) | not))
        | "\(.repository.nameWithOwner) \(.number)"' <<<"$found")

  local skipped
  skipped=$(jq -r --arg skip "$SKIP_LABEL" --argjson drafts "$INCLUDE_DRAFTS" '
    .[] | if (.isDraft and ($drafts | not)) then "\(.repository.nameWithOwner)#\(.number): draft, left alone"
          elif ($skip != "" and ([.labels[].name] | index($skip))) then "\(.repository.nameWithOwner)#\(.number): label \($skip), left alone"
          else empty end' <<<"$found")
  [ -n "$skipped" ] && while read -r line; do log "$line"; done <<<"$skipped"

  if [ -z "$prs" ]; then
    # The state is not wiped: with the wrong account the search comes back empty, and switching
    # back to the right one would repeat the notifications. Every run with PRs rebuilds it anyway.
    [ -z "$skipped" ] && log "no open PRs"
    run_ok
    return 0
  fi

  local new_state='{}' conflicts='[]' repo num key prev info mergeable attempt
  local oid head head_owner base url title behind out
  while read -r repo num; do
    key="$repo#$num"
    prev=$(jq -r --arg k "$key" '.[$k] // ""' <<<"$old_state")

    # GitHub computes mergeable lazily: the first query usually returns UNKNOWN.
    info=""
    for attempt in 1 2 3 4; do
      info=$(gh pr view "$num" -R "$repo" \
        --json mergeable,headRefOid,headRefName,headRepositoryOwner,baseRefName,url,title 2>/dev/null) || info=""
      [ -n "$info" ] || break
      mergeable=$(jq -r .mergeable <<<"$info")
      [ "$mergeable" != "UNKNOWN" ] && break
      sleep $((attempt * 5))
    done
    if [ -z "$info" ]; then
      log "$key: could not read the PR, will retry next run"
      keep_prev
      continue
    fi

    oid=$(jq -r .headRefOid <<<"$info")
    head=$(jq -r .headRefName <<<"$info")
    head_owner=$(jq -r .headRepositoryOwner.login <<<"$info")
    base=$(jq -r .baseRefName <<<"$info")
    url=$(jq -r .url <<<"$info")
    title=$(jq -r .title <<<"$info")
    behind=$(gh api "repos/$repo/compare/$base...$head_owner:$head" --jq .behind_by 2>/dev/null || echo "?")

    case "$mergeable" in
      CONFLICTING)
        if [ "$prev" != "CONFLICTING" ]; then
          log "$key: CONFLICT ($behind behind)"
        else
          log "$key: still conflicting ($behind behind)"
        fi
        new_state=$(jq --arg k "$key" '.[$k]="CONFLICTING"' <<<"$new_state")
        conflicts=$(jq --arg k "$key" --arg t "$title" --arg u "$url" --arg b "$behind" --arg base "$base" \
          --argjson now "$now" --argjson old "$old_conflicts" \
          '. + [{key: $k, title: $t, url: $u, behind: $b, base: $base, since: ($old[$k].since // $now)}]' <<<"$conflicts") ;;
      MERGEABLE)
        if [ "$prev" = "CONFLICTING" ]; then
          log "$key: conflict resolved"
        fi
        if [ "$behind" = "0" ]; then
          log "$key: up to date"
        elif [ "$dry_run" = "1" ]; then
          log "$key: $behind behind → (dry-run) would update the branch"
        elif out=$(gh api -X PUT "repos/$repo/pulls/$num/update-branch" -f expected_head_sha="$oid" 2>&1); then
          log "$key: $behind behind → branch updated from $base (CI will run)"
        else
          log "$key: $behind behind, not updated: $(tr '\n' ' ' <<<"$out")"
        fi
        new_state=$(jq --arg k "$key" '.[$k]="MERGEABLE"' <<<"$new_state") ;;
      *)
        log "$key: GitHub is still computing mergeable ($mergeable), skipping this run"
        keep_prev ;;
    esac
  done <<<"$prs"

  notify_conflicts "$conflicts" "$dry_run"
  if [ "$dry_run" = "0" ]; then
    printf '%s\n' "$new_state" >"$STATE.tmp.$$" && mv -f "$STATE.tmp.$$" "$STATE"
    printf '%s\n' "$conflicts" >"$CONFLICTS.tmp.$$" && mv -f "$CONFLICTS.tmp.$$" "$CONFLICTS"
  fi
  run_ok
}

# A real run that finished fine clears the last error (without notifying: it only logs it).
run_ok() {
  [ "$IN_RUN" = "1" ] && [ -f "$LAST_ERROR" ] || return 0
  log "working again (the last error was: $(cat "$LAST_ERROR"))"
  rm -f "$LAST_ERROR"
}

# Directory lock (mkdir is atomic); an orphan left by a dead process is taken over.
acquire_lock() {
  local pid
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    pid=$(cat "$LOCK_DIR/pid" 2>/dev/null)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && return 1
    rm -rf "$LOCK_DIR"
    mkdir "$LOCK_DIR" 2>/dev/null || return 1
  fi
  echo $$ >"$LOCK_DIR/pid"
  HAVE_LOCK=1
}

cleanup() {
  [ -n "$GH_ERR_FILE" ] && rm -f "$GH_ERR_FILE"
  [ "$HAVE_LOCK" = "1" ] && rm -rf "$LOCK_DIR"
  ui_restore
}

# Detection: one line per result. Used by install (interactive) and detect (JSON).
list_accounts() {
  gh auth status --hostname github.com --json hosts --jq '.hosts["github.com"][].login' 2>/dev/null
}

active_account() {
  gh auth status --hostname github.com --json hosts \
    --jq '.hosts["github.com"][] | select(.active) | .login' 2>/dev/null
}

# Needs use_account first, so the queries go out as the chosen account.
list_orgs() {
  ghq api user/orgs --paginate --jq '.[].login'
}

# Repos with your PRs (open or among the 100 most recent), filtered by owners if any.
list_pr_repos() {
  local owners="$1" open recent
  open=$(ghq search prs --author @me --state open --limit 100 --json repository) || return 1
  recent=$(ghq search prs --author @me --limit 100 --json repository) || return 1
  printf '%s\n%s\n' "$open" "$recent" | jq -r --arg owners "$owners" '.[].repository.nameWithOwner
      | select(. as $repo | $owners == "" or ($owners | split(" ") | index($repo | split("/")[0])))' | sort -u
}

# Every owner and repo in the config must exist and be visible to the account.
check_targets() {
  local o r err
  for o in $OWNERS; do
    ghq api "users/$o" --jq .login >/dev/null && continue
    err=$(gh_err)
    is_network_error "$err" && offline "$err"
    case "$err" in *"HTTP 404"*) die "user or org '$o' does not exist on GitHub" ;; esac
    die "could not verify '$o': $err"
  done
  for r in $REPOS; do
    ghq api "repos/$r" --jq .full_name >/dev/null && continue
    err=$(gh_err)
    is_network_error "$err" && offline "$err"
    case "$err" in *"HTTP 404"*) die "repo '$r' does not exist or your account has no access to it" ;; esac
    die "could not verify '$r': $err"
  done
}

# Other LaunchAgents from pr-watcher or a homemade babysitter: two running at once duplicate updates and notifications.
other_agents() {
  [ "$(uname -s)" = "Darwin" ] || return 0
  launchctl list 2>/dev/null | awk 'NR > 1 {print $3}' | grep -iE 'pr-watcher|babysitter' | grep -vx "$LABEL" || true
}

agent_loaded() {
  [ "$(uname -s)" = "Darwin" ] && launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1
}

# JSON array from lines on stdin.
lines_json() { jq -R . | jq -s 'map(select(. != ""))'; }

cmd_detect() {
  local user=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --user) user="${2:-}"; shift ;;
      --user=*) user="${1#*=}" ;;
      --json) ;;
      *) die "unknown option for detect: $1" ;;
    esac
    shift
  done
  if ! command -v jq >/dev/null; then
    printf '{"errors":[{"step":"deps","message":"jq is missing (brew install jq)"}]}\n'
    exit 1
  fi
  local errors=""
  load_config
  local config_exists=false
  [ -f "$CONFIG" ] && config_exists=true

  local accounts="" active="" account="" cfg_user="$GH_USER" token
  local orgs="" repos="" os scheduler gh_ok=1
  if ! command -v gh >/dev/null; then
    errors+=$(jq -cn '{step:"deps",message:"gh, the GitHub CLI, is missing (brew install gh)"}')$'\n'
    gh_ok=0
  elif ! gh_supports_json; then
    errors+=$(jq -cn --arg v "$(gh --version | head -1)" '{step:"deps",message:("your gh is too old (" + $v + "); upgrade it (brew upgrade gh)")}')$'\n'
    gh_ok=0
  fi
  if [ "$gh_ok" = "1" ]; then
    accounts=$(list_accounts)
    active=$(active_account)
    account="${user:-${GH_USER:-$active}}"
    if [ -z "$accounts" ]; then
      errors+=$(jq -cn '{step:"auth",message:"gh has no session on github.com; run gh auth login"}')$'\n'
    elif ! token=$(gh auth token --user "$account" 2>/dev/null); then
      errors+=$(jq -cn --arg m "gh has no session as '$account'; run gh auth login" '{step:"auth",message:$m}')$'\n'
    else
      export GH_TOKEN="$token"
      orgs=$(list_orgs) \
        || errors+=$(jq -cn --arg m "$(gh_err)" '{step:"orgs",message:("could not list the orgs: " + $m)}')$'\n'
      repos=$(list_pr_repos "") \
        || errors+=$(jq -cn --arg m "$(gh_err)" '{step:"repos",message:("could not list the repos with PRs: " + $m)}')$'\n'
    fi
  fi
  os=$(uname -s)
  scheduler=cron
  [ "$os" = "Darwin" ] && scheduler=launchd
  local loaded=false plist_exists=false
  agent_loaded && loaded=true
  [ -f "$PLIST" ] && plist_exists=true

  jq -n \
    --arg version "$VERSION" --arg os "$os" --arg scheduler "$scheduler" \
    --arg gh "$(command -v gh || true)" --arg jq "$(command -v jq || true)" \
    --arg tn "$(command -v terminal-notifier || true)" \
    --argjson accounts "$(printf '%s\n' "$accounts" | lines_json)" --arg active "$active" \
    --arg account "$account" \
    --argjson orgs "$(printf '%s\n' "$orgs" | lines_json)" \
    --argjson repos "$(printf '%s\n' "$repos" | lines_json)" \
    --arg config_path "$CONFIG" --argjson config_exists "$config_exists" \
    --arg GH_USER "$cfg_user" --arg OWNERS "$OWNERS" --arg REPOS "$REPOS" \
    --arg EVERY_MINUTES "$EVERY_MINUTES" --arg INCLUDE_DRAFTS "$INCLUDE_DRAFTS" --arg SKIP_LABEL "$SKIP_LABEL" \
    --arg label "$LABEL" --arg plist "$PLIST" --argjson loaded "$loaded" --argjson plist_exists "$plist_exists" \
    --argjson others "$(other_agents | lines_json)" \
    --argjson errors "$(printf '%s' "$errors" | jq -s .)" \
    --arg last_error "$(cat "$LAST_ERROR" 2>/dev/null)" \
    '{
      version: $version,
      os: $os,
      scheduler: $scheduler,
      deps: {
        gh: (if $gh == "" then null else $gh end),
        jq: $jq,
        terminal_notifier: (if $tn == "" then null else $tn end)
      },
      accounts: ($accounts | map({login: ., active: (. == $active)})),
      account: (if $account == "" then null else $account end),
      orgs: $orgs,
      repos_with_prs: $repos,
      config: {
        path: $config_path,
        exists: $config_exists,
        values: {GH_USER: $GH_USER, OWNERS: $OWNERS, REPOS: $REPOS,
                 EVERY_MINUTES: ($EVERY_MINUTES | tonumber? // $EVERY_MINUTES),
                 INCLUDE_DRAFTS: ($INCLUDE_DRAFTS == "true"), SKIP_LABEL: $SKIP_LABEL}
      },
      installed: {label: $label, plist: $plist, plist_exists: $plist_exists, agent_loaded: $loaded},
      last_run_error: (if $last_error == "" then null else $last_error end),
      other_watcher_agents: $others,
      errors: $errors
    }'
}

# Installer UI. With a capable terminal: arrow-key menus in the style of create-vite.
# Without one (TERM=dumb or stty doesn't respond): numbered menus, which work anywhere.
FANCY=0
C_RESET="" C_DIM="" C_CYAN="" C_GREEN="" C_BOLD=""
S_START="+" S_BAR="|" S_END="+" S_ACTIVE="*" S_DONE="o" S_ON="[x]" S_OFF="[ ]" S_RON="(*)" S_ROFF="( )"
STTY_SAVED=""
CURSOR_HIDDEN=0

ui_init() {
  [ "${TERM:-dumb}" != "dumb" ] || return 0
  STTY_SAVED=$(stty -g </dev/tty 2>/dev/null) || { STTY_SAVED=""; return 0; }
  exec 4>/dev/tty || return 0
  FANCY=1
  # With echo off, a key pressed while gh queries the network doesn't garble the menu: the next step reads it.
  stty -echo </dev/tty 2>/dev/null
  trap 'exit 130' INT
  if [ -z "${NO_COLOR:-}" ]; then
    C_RESET=$'\e[0m' C_DIM=$'\e[2m' C_CYAN=$'\e[36m' C_GREEN=$'\e[32m' C_BOLD=$'\e[1m'
  fi
  case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *UTF-8*|*utf-8*|*UTF8*|*utf8*)
      S_START="┌" S_BAR="│" S_END="└" S_ACTIVE="◆" S_DONE="◇" S_ON="◼" S_OFF="◻" S_RON="●" S_ROFF="○" ;;
  esac
}

# Leaves the terminal as it was even if the installer stops on an error or Ctrl-C.
ui_restore() {
  [ "$CURSOR_HIDDEN" = "1" ] && printf '\e[?25h' >/dev/tty 2>/dev/null
  [ -n "$STTY_SAVED" ] && stty "$STTY_SAVED" </dev/tty 2>/dev/null
  return 0
}

# A terminal that doesn't report its width (or reports 0) is treated as 80 columns.
ui_cols() {
  local c
  c=$(stty size </dev/tty 2>/dev/null | awk '{print $2}')
  if [[ "$c" =~ ^[0-9]+$ ]] && [ "$c" -ge 20 ]; then echo "$c"; else echo 80; fi
}

# Truncates to the terminal width: a wrapped line breaks the menu redraw.
ui_fit() {
  local max=$(($(ui_cols) - 8)) s="$1"
  [ "${#s}" -le "$max" ] || s="${s:0:max-1}…"
  printf '%s' "$s"
}

ui_intro() { printf '%s%s%s  %s%s%s\n%s%s%s\n' "$C_DIM" "$S_START" "$C_RESET" "$C_BOLD" "$1" "$C_RESET" "$C_DIM" "$S_BAR" "$C_RESET" >&4; }
ui_outro() { printf '%s%s%s  %s\n' "$C_DIM" "$S_END" "$C_RESET" "$1" >&4; }
ui_line() { printf '%s%s%s  %s\n' "$C_DIM" "$S_BAR" "$C_RESET" "$1" >&4; }

# Answered step: the question collapses with its answer.
ui_done() {
  printf '%s%s%s  %s\n' "$C_GREEN" "$S_DONE" "$C_RESET" "$1" >&4
  printf '%s%s%s  %s%s%s\n%s%s%s\n' "$C_DIM" "$S_BAR" "$C_RESET" "$C_DIM" "$(ui_fit "$2")" "$C_RESET" "$C_DIM" "$S_BAR" "$C_RESET" >&4
}

# One installer output line: inside the frame if there is one, to stdout if not.
report() { if [ "$FANCY" = "1" ]; then ui_line "$*"; else echo "$*"; fi; }

# KEY ends up as up, down, left, right, enter, space or the key as typed.
read_key() {
  local k rest=""
  if ! IFS= read -rsn1 k </dev/tty; then KEY=enter; return 0; fi
  case "$k" in
    $'\e')
      IFS= read -rsn2 -t 1 rest </dev/tty
      case "$rest" in
        '[A'|OA) KEY=up ;; '[B'|OB) KEY=down ;; '[C'|OC) KEY=right ;; '[D'|OD) KEY=left ;; *) KEY=esc ;;
      esac ;;
    "") KEY=enter ;;
    " ") KEY=space ;;
    k) KEY=up ;;
    j) KEY=down ;;
    *) KEY="$k" ;;
  esac
}

# Arrow-key menu over LP_LABELS; one = pick one (LP_CUR), many = check several (LP_ON), and in many
# the last option is "all".
list_prompt() {
  local mode="$1" question="$2" hint="$3" n=${#LP_LABELS[@]} i drawn=0 mark color
  printf '\e[?25l' >&4
  CURSOR_HIDDEN=1
  while :; do
    [ "$drawn" -gt 0 ] && printf '\e[%dA\e[J' "$drawn" >&4
    printf '%s%s%s  %s\n' "$C_CYAN" "$S_ACTIVE" "$C_RESET" "$question" >&4
    printf '%s%s%s  %s%s%s\n' "$C_CYAN" "$S_BAR" "$C_RESET" "$C_DIM" "$(ui_fit "$hint")" "$C_RESET" >&4
    for ((i = 0; i < n; i++)); do
      if [ "$mode" = "one" ]; then
        if [ "$i" -eq "$LP_CUR" ]; then mark="$S_RON"; else mark="$S_ROFF"; fi
      else
        if [ "${LP_ON[i]}" = "1" ]; then mark="$S_ON"; else mark="$S_OFF"; fi
      fi
      if [ "$i" -eq "$LP_CUR" ]; then color="$C_CYAN"; else color="$C_DIM"; fi
      [ "$mode" = "many" ] && [ "${LP_ON[i]}" = "1" ] && [ "$i" -ne "$LP_CUR" ] && color=""
      printf '%s%s%s  %s%s %s%s\n' "$C_CYAN" "$S_BAR" "$C_RESET" "$color" "$mark" "$(ui_fit "${LP_LABELS[i]}")" "$C_RESET" >&4
    done
    printf '%s%s%s\n' "$C_CYAN" "$S_END" "$C_RESET" >&4
    drawn=$((n + 3))
    read_key
    case "$KEY" in
      up) LP_CUR=$(((LP_CUR - 1 + n) % n)) ;;
      down) LP_CUR=$(((LP_CUR + 1) % n)) ;;
      space) if [ "$mode" = "many" ]; then
               if [ "${LP_ON[LP_CUR]}" = "1" ]; then LP_ON[LP_CUR]=0; else LP_ON[LP_CUR]=1; fi
               # The last option ("all") excludes the others.
               if [ "${LP_ON[LP_CUR]}" = "1" ]; then
                 for ((i = 0; i < n; i++)); do
                   if [ "$LP_CUR" -eq $((n - 1)) ] && [ "$i" -ne "$LP_CUR" ]; then LP_ON[i]=0; fi
                 done
                 [ "$LP_CUR" -ne $((n - 1)) ] && LP_ON[n - 1]=0
               fi
             fi ;;
      enter) break ;;
    esac
  done
  printf '\e[%dA\e[J\e[?25h' "$drawn" >&4
  CURSOR_HIDDEN=0
}

# choose_one VAR "question" "value|text"...: Enter (or an empty number) keeps VAR's current value.
# Without "|", the value is the text.
choose_one() {
  local var="$1" question="$2" i=1 answer current_idx="" item values=() labels=()
  shift 2
  for item in "$@"; do
    case "$item" in *"|"*) values+=("${item%%|*}"); labels+=("${item#*|}") ;; *) values+=("$item"); labels+=("$item") ;; esac
  done
  for ((i = 0; i < ${#values[@]}; i++)); do [ "${values[i]}" = "${!var}" ] && current_idx=$i; done
  if [ "$FANCY" = "1" ]; then
    LP_LABELS=("${labels[@]}")
    LP_CUR="${current_idx:-0}"
    list_prompt one "$question" "↑↓ choose · enter confirm"
    printf -v "$var" '%s' "${values[LP_CUR]}"
    ui_done "$question" "${labels[LP_CUR]}"
    return 0
  fi
  echo "$question" >/dev/tty
  for ((i = 0; i < ${#labels[@]}; i++)); do printf '  %d) %s\n' $((i + 1)) "${labels[i]}" >/dev/tty; done
  while true; do
    printf '  Number [%s]: ' $((${current_idx:-0} + 1)) >/dev/tty
    IFS= read -r answer </dev/tty || answer=""
    answer="${answer:-$((${current_idx:-0} + 1))}"
    if [[ "$answer" =~ ^[0-9]+$ ]] && [ "$answer" -ge 1 ] && [ "$answer" -le ${#values[@]} ]; then
      printf -v "$var" '%s' "${values[answer - 1]}"
      return 0
    fi
    echo "  Pick a number from the list." >/dev/tty
  done
}

# choose_many VAR "question" "all text" "value|suffix"...: several values separated by spaces.
# The "all" option (or "*" in the numbered menus) or nothing checked leaves VAR empty, which for the
# caller means "all".
choose_many() {
  local var="$1" question="$2" all_text="$3" i=1 answer current="" item n picked ok
  shift 3
  if [ "$FANCY" = "1" ]; then
    LP_LABELS=() LP_ON=()
    for item in "$@"; do
      LP_LABELS+=("${item%%|*}${item#*|}")
      case " ${!var} " in *" ${item%%|*} "*) LP_ON+=(1) ;; *) LP_ON+=(0) ;; esac
    done
    LP_LABELS+=("$all_text")
    if [ -z "${!var}" ]; then LP_ON+=(1); else LP_ON+=(0); fi
    LP_CUR=0
    list_prompt many "$question" "↑↓ move · space select · enter continue"
    picked=""
    i=0
    for item in "$@"; do
      [ "${LP_ON[i]}" = "1" ] && picked="${picked:+$picked }${item%%|*}"
      i=$((i + 1))
    done
    printf -v "$var" '%s' "$picked"
    if [ -n "$picked" ]; then ui_done "$question" "${picked// /, }"; else ui_done "$question" "$all_text"; fi
    return 0
  fi
  echo "$question" >/dev/tty
  for item in "$@"; do
    printf '  %d) %s\n' "$i" "${item%%|*}${item#*|}" >/dev/tty
    case " ${!var} " in *" ${item%%|*} "*) current="${current:+$current }$i" ;; esac
    i=$((i + 1))
  done
  while true; do
    printf '  Numbers separated by spaces, "*" = %s [%s]: ' "$all_text" "${current:-*}" >/dev/tty
    IFS= read -r answer </dev/tty || answer=""
    answer="${answer:-${current:-*}}"
    if [ "$answer" = "*" ]; then printf -v "$var" '%s' ""; return 0; fi
    picked="" ok=1
    for n in $answer; do
      if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le $# ]; then
        item="${!n}"; picked="${picked:+$picked }${item%%|*}"
      else
        ok=0
      fi
    done
    if [ "$ok" = "1" ] && [ -n "$picked" ]; then printf -v "$var" '%s' "$picked"; return 0; fi
    echo "  Pick numbers from the list, or \"*\"." >/dev/tty
  done
}

# ask_bool VAR "question": Yes/No with arrows or y/n; in the numbered menus, y/n typed.
ask_bool() {
  local var="$1" question="$2" answer yes=0 drawn=0
  [ "${!var}" = "true" ] && yes=1
  if [ "$FANCY" = "1" ]; then
    printf '\e[?25l' >&4
    CURSOR_HIDDEN=1
    while :; do
      [ "$drawn" -gt 0 ] && printf '\e[%dA\e[J' "$drawn" >&4
      printf '%s%s%s  %s\n' "$C_CYAN" "$S_ACTIVE" "$C_RESET" "$question" >&4
      if [ "$yes" = "1" ]; then
        printf '%s%s%s  %s%s Yes%s %s/ %s No%s\n' "$C_CYAN" "$S_BAR" "$C_RESET" "$C_CYAN" "$S_RON" "$C_RESET" "$C_DIM" "$S_ROFF" "$C_RESET" >&4
      else
        printf '%s%s%s  %s%s Yes /%s %s%s No%s\n' "$C_CYAN" "$S_BAR" "$C_RESET" "$C_DIM" "$S_ROFF" "$C_RESET" "$C_CYAN" "$S_RON" "$C_RESET" >&4
      fi
      printf '%s%s%s\n' "$C_CYAN" "$S_END" "$C_RESET" >&4
      drawn=3
      read_key
      case "$KEY" in
        left|right|up|down|space) yes=$((1 - yes)) ;;
        y|Y|s|S) yes=1; break ;;
        n|N) yes=0; break ;;
        enter) break ;;
      esac
    done
    printf '\e[%dA\e[J\e[?25h' "$drawn" >&4
    CURSOR_HIDDEN=0
    if [ "$yes" = "1" ]; then printf -v "$var" true; ui_done "$question" "Yes"; else printf -v "$var" false; ui_done "$question" "No"; fi
    return 0
  fi
  while true; do
    printf '%s (y/n)\n  [%s]: ' "$question" "$([ "$yes" = "1" ] && echo y || echo n)" >/dev/tty
    IFS= read -r answer </dev/tty || answer=""
    case "$answer" in
      "") break ;;
      y|Y|yes|Yes|YES|true|s|S|si) yes=1; break ;;
      n|N|no|No|NO|false) yes=0; break ;;
      *) echo "  Answer y or n." >/dev/tty ;;
    esac
  done
  if [ "$yes" = "1" ]; then printf -v "$var" true; else printf -v "$var" false; fi
}

# "0:00, 6:00, 12:00 and 18:00" from "0:00 6:00 12:00 18:00".
join_hours() {
  local list="$1" out="" h last=""
  for h in $list; do
    [ -n "$last" ] && out="${out:+$out, }$last"
    last=$h
  done
  if [ -n "$out" ]; then echo "$out and $last"; else echo "$last"; fi
}

fmt_slot() { printf '%d:%02d' $(($1 / 60)) $(($1 % 60)); }

# Label for each frequency option: with few runs, the times; with many, how many per day.
every_label() {
  local every="$1" count times="" m
  count=$((1440 / every + (1440 % every > 0)))
  case "$every" in
    60) echo "every hour · 24 runs a day" ;;
    1440) echo "once a day · at 0:00" ;;
    *) if [ "$every" -lt 60 ]; then echo "every $every min · $count runs a day"
       elif [ "$count" -le 6 ]; then
         for m in $(schedule_slots "$every"); do times="${times:+$times }$(fmt_slot "$m")"; done
         echo "every $((every / 60)) h · at $(join_hours "$times")"
       else echo "every $((every / 60)) h · $count runs a day"; fi ;;
  esac
}

# Minutes of the day when it runs: from 0:00, every EVERY_MINUTES (or $1).
schedule_slots() {
  local every="${1:-$EVERY_MINUTES}" m=0 slots=""
  while [ "$m" -lt 1440 ]; do
    slots="${slots:+$slots }$m"
    m=$((m + every))
  done
  echo "$slots"
}

# Every run time as h:mm, or the frequency label when there are too many to list.
schedule_desc() {
  local slots m out=""
  slots=$(schedule_slots)
  if [ "$(wc -w <<<"$slots")" -gt 8 ]; then every_label "$EVERY_MINUTES"; return; fi
  for m in $slots; do out="${out:+$out }$(fmt_slot "$m")"; done
  echo "at $(join_hours "$out")"
}

# Under an hour, the minutes repeat every hour; from one hour on, one entry per run.
calendar_entries() {
  local m
  if [ "$EVERY_MINUTES" -lt 60 ]; then
    for m in $(schedule_slots); do
      [ "$m" -lt 60 ] && printf '    <dict><key>Minute</key><integer>%d</integer></dict>\n' "$m"
    done
  else
    for m in $(schedule_slots); do
      printf '    <dict><key>Hour</key><integer>%d</integer><key>Minute</key><integer>%d</integer></dict>\n' $((m / 60)) $((m % 60))
    done
  fi
}

cron_line() { # gh_bin
  local hours=""
  if [ "$EVERY_MINUTES" -lt 60 ]; then
    printf '*/%d * * * *' "$EVERY_MINUTES"
  else
    hours=$(for m in $(schedule_slots); do echo $((m / 60)); done | paste -sd, -)
    printf '0 %s * * *' "$hours"
  fi
  printf ' %s pr-watcher run >>%s/cron.log 2>&1\n' "$1" "$STATE_DIR"
}

plist_xml() {
  local gh_bin="$1" path_env="$2"
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$gh_bin</string>
    <string>pr-watcher</string>
    <string>run</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
EOF
  calendar_entries
  cat <<EOF
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>$path_env</string></dict>
  <key>StandardOutPath</key><string>$STATE_DIR/launchd.out.log</string>
  <key>StandardErrorPath</key><string>$STATE_DIR/launchd.err.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
EOF
}

# Minimal PATH for launchd: the folders holding gh, jq and terminal-notifier, plus the system ones.
schedule_path() {
  local dirs="" tool dir
  for tool in gh jq terminal-notifier; do
    command -v "$tool" >/dev/null || continue
    dir=$(dirname "$(command -v "$tool")")
    case ":$dirs:" in *":$dir:"*) ;; *) dirs="${dirs:+$dirs:}$dir" ;; esac
  done
  for dir in /usr/bin /bin; do
    case ":$dirs:" in *":$dir:"*) ;; *) dirs="$dirs:$dir" ;; esac
  done
  echo "$dirs"
}

cmd_install() {
  local yes=0 dry_run=0 flags=0
  local f_user="" f_owners="" f_repos="" f_every="" f_drafts="" f_skip="" f_image=""
  local set_user=0 set_owners=0 set_repos=0 set_every=0 set_drafts=0 set_skip=0 set_image=0
  while [ $# -gt 0 ]; do
    local opt="$1" val=""
    case "$opt" in
      --*=*) val="${opt#*=}"; opt="${opt%%=*}" ;;
      --user|--owners|--repos|--every|--every-hours|--skip-label|--notify-image)
        [ $# -ge 2 ] || die "$opt needs a value"
        val="$2"; shift ;;
    esac
    case "$opt" in
      --yes|-y) yes=1 ;;
      --dry-run) dry_run=1 ;;
      --user) f_user="$val"; set_user=1 ;;
      --owners) f_owners="$val"; set_owners=1 ;;
      --repos) f_repos="$val"; set_repos=1 ;;
      --every) f_every=$(parse_every "$val"); set_every=1
        offered_every "$f_every" || die "--every must be 15m, 30m, 1h, 2h or 3h (got '$val')" ;;
      --every-hours) f_every=$(parse_every "${val}h"); set_every=1
        offered_every "$f_every" || die "--every-hours must be 1, 2 or 3; for less than an hour, --every 15m or 30m (got '$val')" ;;
      --drafts) f_drafts=true; set_drafts=1 ;;
      --no-drafts) f_drafts=false; set_drafts=1 ;;
      --skip-label) f_skip="$val"; set_skip=1 ;;
      --no-skip-label) f_skip=""; set_skip=1 ;;
      --notify-image) f_image="$val"; set_image=1 ;;
      *) die "unknown option for install: $opt" ;;
    esac
    shift
  done
  flags=$((set_user + set_owners + set_repos + set_every + set_drafts + set_skip + set_image))

  require_jq
  require_gh
  local had_config=0
  [ -f "$CONFIG" ] && had_config=1
  load_config
  [ "$set_user" = "1" ] && GH_USER="$f_user"
  [ "$set_owners" = "1" ] && OWNERS="$f_owners"
  [ "$set_repos" = "1" ] && REPOS="$f_repos"
  [ "$set_every" = "1" ] && { EVERY_MINUTES="$f_every"; LEGACY_EVERY=0; }
  [ "$set_drafts" = "1" ] && INCLUDE_DRAFTS="$f_drafts"
  [ "$set_skip" = "1" ] && SKIP_LABEL="$f_skip"
  [ "$set_image" = "1" ] && NOTIFY_IMAGE="$f_image"

  # With no terminal (an agent, a script) or with flags, nothing is asked.
  local interactive=1
  if [ "$yes" = "1" ] || [ "$flags" -gt 0 ]; then
    interactive=0
  elif ! { : </dev/tty; } 2>/dev/null; then
    interactive=0
    echo "No terminal: installing with the existing config and the defaults (see --help for the flags)." >&2
  fi

  if [ "$interactive" = "0" ]; then
    require_session
    use_account
  else
    ui_init
    if [ "$FANCY" = "1" ]; then
      ui_intro "$NAME"
    else
      echo "$NAME setup. Enter keeps the value in brackets." >/dev/tty
      echo >/dev/tty
    fi

    # Account: only asked if gh has more than one on github.com.
    local accounts=() login
    while IFS= read -r login; do [ -n "$login" ] && accounts+=("$login"); done < <(list_accounts)
    [ ${#accounts[@]} -gt 0 ] || die "gh has no session on github.com; run gh auth login"
    if [ ${#accounts[@]} -eq 1 ]; then
      GH_USER="${accounts[0]}"
      if [ "$FANCY" = "1" ]; then ui_done "Account" "$GH_USER"; else echo "Account: $GH_USER" >/dev/tty; fi
    else
      [ -n "$GH_USER" ] || GH_USER=$(active_account)
      choose_one GH_USER "Which GitHub account?" "${accounts[@]}"
    fi
    require_session
    use_account

    # Orgs: only asked if the account belongs to any; the personal option always sits next to them.
    local orgs=() org orgs_out
    orgs_out=$(list_orgs) || gh_fail "could not list your GitHub orgs"
    while IFS= read -r org; do [ -n "$org" ] && orgs+=("$org"); done <<<"$orgs_out"
    if [ ${#orgs[@]} -eq 0 ]; then
      OWNERS=""
      if [ "$FANCY" = "1" ]; then
        ui_done "Orgs" "you don't belong to any, watching all your PRs"
      else
        echo "Orgs: you don't belong to any, watching all your PRs." >/dev/tty
      fi
    else
      [ "$had_config" = "1" ] || OWNERS="${orgs[*]}"
      local owner_items=()
      for org in "${orgs[@]}"; do owner_items+=("$org|"); done
      owner_items+=("$GH_USER| (your personal repos)")
      choose_many OWNERS "Which PRs to watch?" "all your PRs, in any repo" "${owner_items[@]}"
    fi

    # Repos: those with your PRs (open or recent) within the selection; with no real choice, not asked.
    local repos=() repo repos_out
    repos_out=$(list_pr_repos "$OWNERS") || gh_fail "could not list the repos with your PRs"
    while IFS= read -r repo; do [ -n "$repo" ] && repos+=("$repo"); done <<<"$repos_out"
    local kept="" r all_repos=""
    [ ${#repos[@]} -gt 0 ] && all_repos=" ${repos[*]} "
    for r in $REPOS; do
      case "$all_repos" in *" $r "*) kept="${kept:+$kept }$r" ;; esac
    done
    REPOS="$kept"
    if [ ${#repos[@]} -gt 1 ]; then
      local repo_items=()
      for repo in "${repos[@]}"; do repo_items+=("$repo|"); done
      choose_many REPOS "Only some repos? (the ones with your PRs)" "all repos in the selection" "${repo_items[@]}"
    fi
    [ "$FANCY" = "1" ] || echo >/dev/tty

    # Frequency: an older config with a longer interval starts from the longest one offered.
    local every_items=() m
    for m in $EVERY_OPTIONS; do every_items+=("$m|$(every_label "$m")"); done
    offered_every "$EVERY_MINUTES" || EVERY_MINUTES=180
    LEGACY_EVERY=0
    choose_one EVERY_MINUTES "How often?" "${every_items[@]}"
    ask_bool INCLUDE_DRAFTS "Update drafts too?"
    local use_skip_label=false
    [ -n "$SKIP_LABEL" ] && use_skip_label=true
    ask_bool use_skip_label "Exclude PRs labeled ${SKIP_LABEL:-no-autoupdate}?"
    if [ "$use_skip_label" = "true" ]; then SKIP_LABEL="${SKIP_LABEL:-no-autoupdate}"; else SKIP_LABEL=""; fi
    local go=true
    ask_bool go "Install with this config?"
    if [ "$go" != "true" ]; then
      if [ "$FANCY" = "1" ]; then ui_outro "Cancelled, nothing was changed."; else echo "Cancelled, nothing was changed." >/dev/tty; fi
      return 0
    fi
    [ "$FANCY" = "1" ] || echo >/dev/tty
  fi
  offered_every "$EVERY_MINUTES" || [ "$LEGACY_EVERY" = "0" ] \
    || die "EVERY_HOURS=$EVERY_HOURS is no longer offered: pick --every 15m, 30m, 1h, 2h or 3h"
  validate_config
  check_targets

  if [ "$dry_run" = "1" ]; then
    [ "$FANCY" = "1" ] && ui_outro "dry-run: nothing was written, this is what you'd get"
    echo "# (dry-run) config that would be written to $CONFIG"
    local k
    for k in $CONFIG_KEYS; do echo "$k=${!k}"; done
  else
    write_config
    report "Config saved to $CONFIG"
  fi

  local gh_bin
  gh_bin=$(command -v gh) || die "gh, the GitHub CLI, is missing (brew install gh)"

  case "$(uname -s)" in
    Darwin)
      local others
      others=$(other_agents)
      if [ -n "$others" ]; then
        if [ "$FANCY" = "1" ] && [ "$dry_run" = "0" ]; then
          report "Warning: another PR-updating LaunchAgent is loaded ($others); both will update and notify."
        else
          echo "Warning: another PR-updating LaunchAgent is loaded ($others); both will update and notify." >&2
        fi
      fi
      if [ "$dry_run" = "1" ]; then
        echo
        echo "# (dry-run) LaunchAgent that would be written to $PLIST"
        plist_xml "$gh_bin" "$(schedule_path)"
        return 0
      fi
      mkdir -p "$STATE_DIR" "$(dirname "$PLIST")"
      plist_xml "$gh_bin" "$(schedule_path)" >"$PLIST"
      launchctl bootout "gui/$(id -u)/$LABEL" >/dev/null 2>&1 || true
      launchctl bootstrap "gui/$(id -u)" "$PLIST" || die "launchctl bootstrap failed"
      report "Scheduled $(every_label "$EVERY_MINUTES") (launchd, $LABEL)."
      command -v terminal-notifier >/dev/null \
        || report "Warning: without terminal-notifier, clicking a notification doesn't open the PR (brew install terminal-notifier)."
      if [ "$FANCY" = "1" ]; then
        ui_outro "Try it without changing anything: gh pr-watcher run --dry-run"
      else
        echo "Try it without changing anything: gh pr-watcher run --dry-run"
      fi
      ;;
    *)
      [ "$FANCY" = "1" ] && [ "$dry_run" = "0" ] && ui_outro "You still need to schedule it by hand:"
      echo
      echo "This system has no launchd. Add this line with \`crontab -e\`:"
      echo
      cron_line "$gh_bin"
      ;;
  esac
}

cmd_uninstall() {
  if [ "$(uname -s)" = "Darwin" ]; then
    launchctl bootout "gui/$(id -u)/$LABEL" >/dev/null 2>&1 || true
    rm -f "$PLIST"
    echo "LaunchAgent removed. Config ($CONFIG) and log ($STATE_DIR) stay; delete them by hand if you want."
  else
    echo "Remove the pr-watcher line with \`crontab -e\`."
  fi
  echo "To remove the extension: gh extension remove pr-watcher"
}

cmd_status() {
  load_config
  if [ "${1:-}" = "--json" ]; then
    require_jq
    local loaded=false config_exists=false state='{}'
    agent_loaded && loaded=true
    [ -f "$CONFIG" ] && config_exists=true
    [ -s "$STATE" ] && jq -e . "$STATE" >/dev/null 2>&1 && state=$(cat "$STATE")
    jq -n --arg version "$VERSION" --arg config_path "$CONFIG" --argjson config_exists "$config_exists" \
      --arg GH_USER "$GH_USER" --arg OWNERS "$OWNERS" --arg REPOS "$REPOS" \
      --arg EVERY_MINUTES "$EVERY_MINUTES" --arg INCLUDE_DRAFTS "$INCLUDE_DRAFTS" --arg SKIP_LABEL "$SKIP_LABEL" \
      --argjson loaded "$loaded" --arg slots "$(schedule_slots)" --argjson state "$state" \
      --argjson log "$(tail -20 "$LOG" 2>/dev/null | lines_json)" \
      --arg last_error "$(cat "$LAST_ERROR" 2>/dev/null)" --arg last_run "$(cat "$LAST_RUN" 2>/dev/null)" \
      '{version: $version,
        config: {path: $config_path, exists: $config_exists,
                 values: {GH_USER: $GH_USER, OWNERS: $OWNERS, REPOS: $REPOS,
                          EVERY_MINUTES: ($EVERY_MINUTES | tonumber? // $EVERY_MINUTES),
                          INCLUDE_DRAFTS: ($INCLUDE_DRAFTS == "true"), SKIP_LABEL: $SKIP_LABEL}},
        agent_loaded: $loaded,
        schedule_minutes: ($slots | split(" ") | map(tonumber? // empty)),
        pr_state: $state,
        last_run_error: (if $last_error == "" then null else $last_error end),
        last_run_at: ($last_run | tonumber? // null),
        last_log: $log}'
    return 0
  fi
  echo "$NAME $VERSION"
  echo
  if [ -f "$LAST_ERROR" ]; then
    echo "The last run failed: $(cat "$LAST_ERROR")"
    echo "  (clears itself when a run succeeds; diagnose: gh pr-watcher doctor)"
    echo
  fi
  [ -s "$LAST_RUN" ] && { echo "Last run: $(fmt_epoch "$(cat "$LAST_RUN")")"; echo; }
  if [ -f "$CONFIG" ]; then
    echo "Config ($CONFIG):"
    local k
    for k in $CONFIG_KEYS; do printf '  %-16s %s\n' "$k" "${!k:-(empty)}"; done
  else
    echo "No config yet: gh pr-watcher install"
  fi
  echo
  if [ "$(uname -s)" = "Darwin" ]; then
    if launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then
      echo "Agent: loaded ($LABEL), runs $(schedule_desc)"
    else
      echo "Agent: not loaded"
    fi
  fi
  if [ -f "$LOG" ]; then
    echo
    echo "Last log lines:"
    tail -10 "$LOG" | sed 's/^/  /'
  fi
}

cmd_config() {
  echo "$CONFIG"
  [ -f "$CONFIG" ] && { echo; cat "$CONFIG"; } || echo "(doesn't exist yet: gh pr-watcher install)"
}

cmd_log() {
  local n="${1:-30}"
  [[ "$n" =~ ^[0-9]+$ ]] || die "log expects a number of lines (e.g. gh pr-watcher log 50)"
  [ -f "$LOG" ] || die "no log yet ($LOG)"
  tail -n "$n" "$LOG"
}

cmd_test_notify() {
  load_config
  validate_config
  local img="${NOTIFY_IMAGE:-$DEFAULT_IMAGE}" via="osascript (no click or image)"
  command -v terminal-notifier >/dev/null && via="terminal-notifier"
  command -v terminal-notifier >/dev/null || command -v osascript >/dev/null \
    || command -v notify-send >/dev/null || die "nothing to send notifications with (brew install terminal-notifier)"
  notify "test" "This is what a conflicted PR notification looks like." "https://github.com/pulls" "test"
  echo "Notification sent via $via."
  [ "$via" = "terminal-notifier" ] && { [ -r "$img" ] && echo "Image: $img" || echo "No image: can't find $img"; }
  echo "If it doesn't show up, check System Settings → Notifications → ${via%% *}."
}

fmt_epoch() { date -r "$1" '+%F %H:%M' 2>/dev/null || date -d "@$1" '+%F %H:%M'; }

# Seconds from a macOS sysctl shaped like "{ sec = N, usec = ... }"; 0 if it doesn't exist.
sysctl_sec() { sysctl -n "$1" 2>/dev/null | sed -nE 's/^\{ sec = ([0-9]+).*/\1/p' | grep . || echo 0; }

# Minutes of the day the LaunchAgent runs at; an entry without Hour repeats every hour.
plist_slots() {
  plutil -extract StartCalendarInterval json -o - "$PLIST" 2>/dev/null | jq -r '
    [.[] | if has("Hour") then .Hour * 60 + (.Minute // 0) else range(0; 24) as $h | $h * 60 + (.Minute // 0) end]
    | sort | map(tostring) | join(" ")'
}

# Result of a doctor check: ok, warn or fail, with the fix if there is one.
DOCTOR_CHECKS=""
check() { # status id message [fix]
  DOCTOR_CHECKS+=$(jq -cn --arg s "$1" --arg i "$2" --arg m "$3" --arg f "${4:-}" \
    '{id: $i, status: $s, message: $m, fix: (if $f == "" then null else $f end)}')$'\n'
}

# Runs a function that stops with die in a subshell; the reason lands in PROBE_MSG and doctor carries on.
PROBE_MSG=""
probe() {
  local out rc
  out=$( ( "$@" ) 2>&1 >/dev/null )
  rc=$?
  PROBE_MSG=$(grep '^error: ' <<<"$out" | tail -1 | sed 's/^error: //')
  return $rc
}

# Whether launchd fired the last scheduled run. Only counts if the machine was on at that
# time: asleep, launchd runs on wake; powered off, that run is lost and it's not a failure.
check_last_run() {
  local slots now now_m m slot=0 next="" slot_at last boot wake installed expected grace
  slots=$(plist_slots)
  [ -n "$slots" ] || return 0
  now=$(date +%s)
  now_m=$((10#$(date +%H) * 60 + 10#$(date +%M)))
  for m in $slots; do
    if [ "$m" -le "$now_m" ]; then slot=$m; elif [ -z "$next" ]; then next=$m; fi
  done
  [ -n "$next" ] || next=$(awk '{print $1}' <<<"$slots")
  slot_at=$(date -j -f '%Y-%m-%d %H:%M:%S' "$(date +%F) $(printf '%02d:%02d' $((slot / 60)) $((slot % 60))):00" +%s)
  last=$(cat "$LAST_RUN" 2>/dev/null)
  [[ "$last" =~ ^[0-9]+$ ]] || last=0
  boot=$(sysctl_sec kern.boottime)
  wake=$(sysctl_sec kern.waketime)
  installed=$(stat -f %m "$PLIST" 2>/dev/null || echo 0)
  # Half the interval, capped at 15 min: with frequent runs the next slot comes before 15 min go by.
  grace=900
  [[ "$EVERY_MINUTES" =~ ^[0-9]+$ ]] && [ "$EVERY_MINUTES" -lt 60 ] && grace=$((EVERY_MINUTES * 30))
  if [ "$last" -ge "$slot_at" ]; then
    check ok last_run "last run: $(fmt_epoch "$last")"
  elif [ "$installed" -gt "$slot_at" ] || [ "$boot" -gt "$slot_at" ]; then
    check ok last_run "not due to run yet (next: $(fmt_slot "$next"))"
  else
    expected=$slot_at
    [ "$wake" -gt "$expected" ] && expected=$wake
    if [ $((now - expected)) -gt "$grace" ]; then
      check fail last_run "should have run at $(fmt_epoch "$expected") and didn't (last: $([ "$last" -gt 0 ] && fmt_epoch "$last" || echo never))" \
        "check launchctl print gui/$(id -u)/$LABEL and $STATE_DIR/launchd.err.log; then gh pr-watcher install --yes"
    else
      check ok last_run "due to run now (at $(fmt_slot "$slot"))"
    fi
  fi
}

cmd_doctor() {
  local json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      *) die "unknown option for doctor: $1" ;;
    esac
    shift
  done
  if ! command -v jq >/dev/null; then
    if [ "$json" = "1" ]; then
      printf '{"ok":false,"checks":[{"id":"jq","status":"fail","message":"jq is missing","fix":"brew install jq"}]}\n'
    else
      printf '✗ jq is missing\n    → brew install jq\n'
    fi
    exit 1
  fi

  # Dependencies.
  local gh_ok=0
  if probe require_gh; then
    gh_ok=1
    check ok gh "$(gh --version | head -1)"
  else
    check fail gh "$PROBE_MSG"
  fi
  check ok jq "$(jq --version)"
  if [ "$(uname -s)" = "Darwin" ] && ! command -v terminal-notifier >/dev/null; then
    check warn notifier "no terminal-notifier: notifications don't open the PR on click and carry no image" "brew install terminal-notifier"
  fi

  # Config: load_config warnings come out as warn; then, the validation.
  local config_ok=0 line
  if [ -f "$CONFIG" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] && check warn config_syntax "${line#warning: }" "fix the line in $CONFIG"
    done < <( ( load_config ) 2>&1 )
    load_config 2>/dev/null
    if probe validate_config; then
      config_ok=1
      check ok config "valid config ($CONFIG)"
      [ "$LEGACY_EVERY" = "1" ] && check warn config_legacy "the config still uses EVERY_HOURS, replaced by EVERY_MINUTES" \
        "gh pr-watcher install (rewrites the config and the schedule)"
    else
      check fail config "$PROBE_MSG" "fix it in $CONFIG or with gh pr-watcher install"
    fi
  else
    check fail config "no config yet" "gh pr-watcher install"
  fi

  # Session, account and access to what's watched.
  if [ "$gh_ok" = "1" ]; then
    if probe require_session && probe use_account; then
      use_account
      local who="${GH_USER:-$(active_account)}"
      check ok session "gh session as '$who', with the repo scope"
      if [ "$config_ok" = "1" ]; then
        if probe check_targets; then
          local targets="${REPOS:-$OWNERS}"
          if [ -n "$targets" ]; then check ok targets "accessible: $targets"; else check ok targets "no filter: all your open PRs"; fi
        else
          check fail targets "$PROBE_MSG" "fix OWNERS/REPOS; gh pr-watcher detect lists what your account can see"
        fi
      fi
    else
      case "$PROBE_MSG" in
        "could not connect"*) check fail session "$PROBE_MSG" "check the connection (or the proxy) and run doctor again" ;;
        *) check fail session "$PROBE_MSG" ;;
      esac
    fi
  fi

  # Schedule.
  if [ "$(uname -s)" = "Darwin" ]; then
    if [ ! -f "$PLIST" ]; then
      check fail agent "not scheduled" "gh pr-watcher install"
    elif ! agent_loaded; then
      check fail agent "the LaunchAgent exists but isn't loaded" "gh pr-watcher install --yes"
    else
      local plist_gh plist_s
      plist_gh=$(plutil -extract ProgramArguments.0 raw "$PLIST" 2>/dev/null)
      plist_s=$(plist_slots)
      if [ ! -x "$plist_gh" ]; then
        check fail agent "the LaunchAgent points to a gh that no longer exists ($plist_gh)" "gh pr-watcher install --yes"
      elif [ "$config_ok" = "1" ] && [ "$plist_s" != "$(schedule_slots)" ]; then
        check fail agent "the LaunchAgent doesn't match EVERY_MINUTES=$EVERY_MINUTES ($(every_label "$EVERY_MINUTES"))" "gh pr-watcher install --yes"
      else
        check ok agent "scheduled $(schedule_desc) ($LABEL)"
      fi
      check_last_run
    fi
    local other
    while IFS= read -r other; do
      [ -n "$other" ] && check fail others "another PR-updating agent is running ($other): both update and notify" \
        "if this one replaces it: launchctl bootout gui/$(id -u)/$other and delete its plist from ~/Library/LaunchAgents (otherwise it comes back at the next login)"
    done < <(other_agents)
  else
    check warn agent "no launchd: doctor doesn't check the schedule" "crontab -l | grep pr-watcher"
  fi

  # Traces of previous runs.
  if [ -s "$LAST_ERROR" ]; then
    check fail last_error "the last run failed: $(cat "$LAST_ERROR")" \
      "fix the issues above and try gh pr-watcher run; the error clears once a run succeeds"
  fi
  if [ -s "$STATE" ] && ! jq -e 'type == "object"' "$STATE" >/dev/null 2>&1; then
    check warn state "the state is corrupted: the next run discards it and counts the open conflicts as new"
  fi
  if [ -d "$LOCK_DIR" ]; then
    local pid
    pid=$(cat "$LOCK_DIR/pid" 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && [ -n "$(find "$LOCK_DIR" -maxdepth 0 -mmin +60 2>/dev/null)" ]; then
      check warn lock "a run has been going for over 1 h (pid $pid)" "kill $pid"
    fi
  fi

  local checks ok
  checks=$(printf '%s' "$DOCTOR_CHECKS" | jq -s .)
  ok=$(jq 'all(.status != "fail")' <<<"$checks")
  if [ "$json" = "1" ]; then
    jq -n --argjson checks "$checks" --argjson ok "$ok" '{ok: $ok, checks: $checks}'
  else
    jq -r '.[] | ({ok: "✓", warn: "!", fail: "✗"}[.status]) + " " + .message
               + (if .fix then "\n    → " + .fix else "" end)' <<<"$checks"
    echo
    local fails
    fails=$(jq '[.[] | select(.status == "fail")] | length' <<<"$checks")
    if [ "$ok" = "true" ]; then echo "All good."; else echo "$fails problem(s) to fix."; fi
  fi
  [ "$ok" = "true" ]
}

# A one-letter typo (rub, stauts) or a prefix (inst) suggests the real command.
suggest_command() {
  local typed="$1" c i diff
  for c in run install uninstall status detect doctor config log test-notify version help; do
    if [[ "$c" == "$typed"* ]] && [ ${#typed} -ge 2 ]; then printf ' (did you mean %s?)' "$c"; return 0; fi
    [ ${#c} -eq ${#typed} ] || continue
    diff=0
    for ((i = 0; i < ${#c}; i++)); do [ "${c:i:1}" = "${typed:i:1}" ] || diff=$((diff + 1)); done
    if [ "$diff" -le 1 ]; then printf ' (did you mean %s?)' "$c"; return 0; fi
    # Two adjacent letters swapped.
    for ((i = 0; i < ${#c} - 1; i++)); do
      if [ "${typed:0:i}${typed:i+1:1}${typed:i:1}${typed:i+2}" = "$c" ]; then printf ' (did you mean %s?)' "$c"; return 0; fi
    done
  done
}

main() {
  GH_ERR_FILE=$(mktemp "${TMPDIR:-/tmp}/$NAME.XXXXXX")
  trap cleanup EXIT
  local cmd="${1:-help}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    run) cmd_run "$@" ;;
    install) cmd_install "$@" ;;
    uninstall) cmd_uninstall ;;
    status) cmd_status "$@" ;;
    detect) cmd_detect "$@" ;;
    config) cmd_config ;;
    log) cmd_log "$@" ;;
    test-notify) cmd_test_notify ;;
    doctor) cmd_doctor "$@" ;;
    version|--version|-v) echo "$NAME $VERSION" ;;
    help|--help|-h) usage ;;
    *) die "unknown command: $cmd$(suggest_command "$cmd") (gh pr-watcher help lists the commands)" ;;
  esac
}

main "$@"
